# Copy to .env and fill in. Loaded with override=True by every harness, so a
# value here beats one already exported in the shell.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# openai   -> any OpenAI-compatible server, including the local vLLM (default)
# anthropic -> the hosted Claude API; the prefetch env vars are cleared
#              automatically, since warming a local cache would be pointless
MODEL_PROVIDER=openai
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct-AWQ
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY
MODEL_TEMPERATURE=0.0
# OPENAI_REPETITION_PENALTY=1.05

# Per-call-site output budgets (see agent/common/model.py)
PLAN_MODEL_MAX_TOKENS=4096
RESEARCH_MODEL_MAX_TOKENS=8192
EXTRACT_PLAN_MODEL_MAX_TOKENS=16384
DIFF_MODEL_MAX_TOKENS=16384
NEW_FILE_MODEL_MAX_TOKENS=16384

# ---------------------------------------------------------------------------
# Loop bounds (agent/common/configuration.py)
# ---------------------------------------------------------------------------
MAX_RESEARCHER_ITERATIONS=6
MAX_REACT_TOOL_CALLS=8
MAX_ATOMIC_TASKS=20
GRAPH_RECURSION_LIMIT=200

# ---------------------------------------------------------------------------
# SWE-bench
# ---------------------------------------------------------------------------
SWE_DATASET=SWE-bench/SWE-bench_Verified
SWE_SPLIT=test
# Where each instance is checked out. The agent hard-codes ./workspace_repo, so
# changing this needs the agent changed too.
SWE_WORKSPACE_DIR=./workspace_repo
# Bare mirrors, so a repo is cloned from GitHub once per machine
SWE_REPO_CACHE=~/.cache/swe-agent-bench/repos

# ---------------------------------------------------------------------------
# Prefix prefetch (treatment arm) -- run_evaluate.py
# ---------------------------------------------------------------------------
# EITHER of these turns the prefetch worker on; run_evaluate_node_eviction.py
# clears both, deliberately.
# LANGGRAPH_VLLM_AGENT_ENABLE=1
# LANGGRAPH_VLLM_AGENT_BASE_URL=http://localhost:8000/v1/agents
# LANGGRAPH_VLLM_AGENT_NAMESPACE=swe
# The fork's HTTP default is 30s, which times out mid-warmup on a large model.
# LANGGRAPH_VLLM_AGENT_TIMEOUT=180
# Fill pseudo-dynamic prompt segments when building a prefix (default on)
# LANGGRAPH_PROMPT_PSEUDO_DYNAMIC=1
# Names the experiment only; nothing reads it as a switch.
LANGGRAPH_ABLATION_MODE=full
# Every compile(_is_root=True) dumps the prompt/transition metadata. Unset, it
# writes ./debug.txt into the *current working directory* on every run; point it
# somewhere out of the repo.
LANGGRAPH_COMPILE_DEBUG_PATH=./.langgraph_compile_debug.json

# ---------------------------------------------------------------------------
# Node-aware KV eviction -- run_evaluate_node_eviction.py
# ---------------------------------------------------------------------------
# Unset means the forecast publishes nothing and vLLM ranks nothing.
# KV_FORECAST_REDIS_URL=redis://localhost:6379/0
# KV_PREDICTION_TRANSITION_STORE=./kv_forecast/transitions.json
# VLLM_REQUEST_STATS_DIR=./vllm_stats
# KV_EVICTION_DISABLE_PREFETCH=1

# ---------------------------------------------------------------------------
# Tracing
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2-...
# LANGSMITH_EXPERIMENT=

# ---------------------------------------------------------------------------
# Fixed-trace study (agent/common/trace_store.py)
# ---------------------------------------------------------------------------
# off | record | pinned | offline. Env applies to every harness; run_evaluate.py
# also takes --trace-mode / --trace-path, which win over these.
# SWE_TRACE_MODE=off
# SWE_TRACE_PATH=/disk2/vibhav/traces/drb_v1_1_swe.jsonl
# strict = raise when the trajectory diverges from the recording; live = fall
# back to a real call (default).
# SWE_TRACE_ON_MISS=live
# 1 caps the pinned live call at the recorded completion length. Off by
# default: the live call runs to its own stopping point instead of being cut
# off mid-stream, so the timing reflects the whole response.
# SWE_TRACE_PIN_LENGTH=0
# Divergence report; defaults to <trace>.divergence.jsonl
# SWE_TRACE_REPORT=
# Where pinned mode dumps the recorded and live outputs side by side. One JSON
# file per request, in the working directory: calls that stopped before the
# baseline's token count go to ./trace_early_exits/, every other pinned call to
# ./trace_full_length/.
# SWE_TRACE_EARLY_EXIT_DIR=
# SWE_TRACE_FULL_DUMP_DIR=
